            .hash = "N-V-__8AANL3jAxtkd8Pk-KCVsWvAZms1rQw27W8qXNNHPuV",
            .lazy = true,
        },
        // Linux: BtbN's matching build, and sharp's libvips (one library with its
        // dependencies and glib built in). Both need only glibc 2.28.
        .ffmpeg_linux = .{
            .url = "https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-08-31-13-27/ffmpeg-n8.1.2-50-g1a748fe2cd-linux64-gpl-shared-8.1.tar.xz",
